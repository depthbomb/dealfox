  "statements": [
    "CREATE TABLE \"apps\" (\n  \"id\" INTEGER PRIMARY KEY CONSTRAINT \"app_id_positive\" CHECK (id \u003e 0),\n  \"name\" TEXT NOT NULL CHECK (length(\"name\") \u003e 0),\n  \"type\" TEXT NOT NULL,\n  \"last_modified\" INTEGER NOT NULL DEFAULT 0,\n  \"price_change_number\" INTEGER NOT NULL DEFAULT 0,\n  \"updated_at\" TEXT NOT NULL,\n  \"name_fold\" TEXT NOT NULL DEFAULT ''\n) STRICT;",
    "CREATE INDEX \"apps_name_fold\" ON \"apps\" (\"name_fold\");",
    "CREATE TABLE \"deliveries\" (\n  \"id\" TEXT PRIMARY KEY NOT NULL CHECK (length(\"id\") \u003e 0) CHECK (length(\"id\") \u003c= 24),\n  \"event_id\" TEXT NOT NULL UNIQUE REFERENCES \"events\" (\"id\"),\n  \"destination_id\" TEXT NOT NULL CHECK (length(\"destination_id\") \u003e 0),\n  \"status\" TEXT NOT NULL DEFAULT 'pending' CHECK (\"status\" IN ('pending', 'sending', 'retry', 'sent', 'dead', 'cancelled')),\n  \"attempt_count\" INTEGER NOT NULL DEFAULT 0 CONSTRAINT \"delivery_attempt_count_nonnegative\" CHECK (attempt_count \u003e= 0),\n  \"next_attempt_at\" TEXT NOT NULL,\n  \"message_id\" TEXT NOT NULL DEFAULT '',\n  \"last_error\" TEXT NOT NULL DEFAULT '',\n  \"created_at\" TEXT NOT NULL,\n  \"updated_at\" TEXT NOT NULL\n) STRICT;",
    "CREATE INDEX \"deliveries_status_next_attempt_at\" ON \"deliveries\" (\"status\", \"next_attempt_at\");",
    "CREATE TABLE \"events\" (\n  \"id\" TEXT PRIMARY KEY NOT NULL CHECK (length(\"id\") \u003e 0) CHECK (length(\"id\") \u003c= 24),\n  \"rule_id\" TEXT NOT NULL REFERENCES \"rules\" (\"id\"),\n  \"observation_id\" TEXT NOT NULL REFERENCES \"observations\" (\"id\"),\n  \"payload\" TEXT NOT NULL,\n  \"created_at\" TEXT NOT NULL\n) STRICT;",
    "CREATE UNIQUE INDEX \"events_rule_id_observation_id\" ON \"events\" (\"rule_id\", \"observation_id\");",
    "CREATE TABLE \"free_deliveries\" (\n  \"id\" TEXT PRIMARY KEY NOT NULL CHECK (length(\"id\") \u003e 0) CHECK (length(\"id\") \u003c= 24),\n  \"offer_id\" TEXT NOT NULL CHECK (length(\"offer_id\") \u003e 0),\n  \"subscription_id\" TEXT NOT NULL CHECK (length(\"subscription_id\") \u003e 0),\n  \"offer_generation\" INTEGER NOT NULL DEFAULT 1 CONSTRAINT \"freedelivery_offer_generation_positive\" CHECK (offer_generation \u003e 0),\n  \"destination_kind\" TEXT NOT NULL CHECK (\"destination_kind\" IN ('dm', 'channel')),\n  \"destination_id\" TEXT NOT NULL CHECK (length(\"destination_id\") \u003e 0),\n  \"payload\" TEXT NOT NULL,\n  \"status\" TEXT NOT NULL DEFAULT 'pending' CHECK (\"status\" IN ('pending', 'sending', 'retry', 'sent', 'dead', 'cancelled')),\n  \"attempt_count\" INTEGER NOT NULL DEFAULT 0 CONSTRAINT \"freedelivery_attempt_count_nonnegative\" CHECK (attempt_count \u003e= 0),\n  \"next_attempt_at\" TEXT NOT NULL,\n  \"message_id\" TEXT NOT NULL DEFAULT '',\n  \"last_error\" TEXT NOT NULL DEFAULT '',\n  \"created_at\" TEXT NOT NULL,\n  \"updated_at\" TEXT NOT NULL\n) STRICT;",
    "CREATE UNIQUE INDEX \"free_deliveries_offer_id_offer_generation_subscription_id\" ON \"free_deliveries\" (\"offer_id\", \"offer_generation\", \"subscription_id\");",
    "CREATE INDEX \"free_deliveries_status_next_attempt_at\" ON \"free_deliveries\" (\"status\", \"next_attempt_at\");",
    "CREATE TABLE \"free_monitors\" (\n  \"id\" TEXT PRIMARY KEY NOT NULL,\n  \"checked_at\" TEXT,\n  \"next_check_at\" TEXT NOT NULL,\n  \"status\" TEXT NOT NULL DEFAULT 'not checked',\n  \"problems\" TEXT NOT NULL DEFAULT '[]',\n  \"failures\" INTEGER NOT NULL DEFAULT 0\n) STRICT;",
    "CREATE TABLE \"free_offers\" (\n  \"id\" TEXT PRIMARY KEY NOT NULL CHECK (length(\"id\") \u003e 0) CHECK (length(\"id\") \u003c= 24),\n  \"identity\" TEXT NOT NULL UNIQUE,\n  \"source\" TEXT NOT NULL CHECK (length(\"source\") \u003e 0),\n  \"payload\" TEXT NOT NULL,\n  \"eligible\" INTEGER NOT NULL DEFAULT 0 CHECK (\"eligible\" IN (0, 1)),\n  \"closed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"closed\" IN (0, 1)),\n  \"generation\" INTEGER NOT NULL DEFAULT 1 CONSTRAINT \"freeoffer_generation_positive\" CHECK (generation \u003e 0),\n  \"first_seen_at\" TEXT NOT NULL,\n  \"last_seen_at\" TEXT NOT NULL\n) STRICT;",
    "CREATE INDEX \"free_offers_source_eligible\" ON \"free_offers\" (\"source\", \"eligible\");",
    "CREATE TABLE \"free_subscriptions\" (\n  \"id\" TEXT PRIMARY KEY NOT NULL CHECK (length(\"id\") \u003e 0) CHECK (length(\"id\") \u003c= 24),\n  \"scope\" TEXT NOT NULL CHECK (length(\"scope\") \u003e 0),\n  \"source\" TEXT NOT NULL CHECK (length(\"source\") \u003e 0),\n  \"destination_kind\" TEXT NOT NULL CHECK (\"destination_kind\" IN ('dm', 'channel')),\n  \"destination_id\" TEXT NOT NULL CHECK (length(\"destination_id\") \u003e 0),\n  \"managed_by\" TEXT NOT NULL CHECK (length(\"managed_by\") \u003e 0),\n  \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)),\n  \"created_at\" TEXT NOT NULL,\n  \"updated_at\" TEXT NOT NULL\n) STRICT;",
    "CREATE UNIQUE INDEX \"free_subscriptions_scope_source\" ON \"free_subscriptions\" (\"scope\", \"source\");",
    "CREATE INDEX \"free_subscriptions_source_enabled\" ON \"free_subscriptions\" (\"source\", \"enabled\");",
    "CREATE TABLE \"observations\" (\n  \"id\" TEXT PRIMARY KEY NOT NULL CHECK (length(\"id\") \u003e 0) CHECK (length(\"id\") \u003c= 24),\n  \"target_id\" TEXT NOT NULL REFERENCES \"targets\" (\"id\"),\n  \"observed_at\" TEXT NOT NULL,\n  \"price\" TEXT NOT NULL\n) STRICT;",
    "CREATE INDEX \"observations_observed_at\" ON \"observations\" (\"observed_at\");",
    "CREATE INDEX \"observations_target_id_observed_at\" ON \"observations\" (\"target_id\", \"observed_at\");",
    "CREATE TABLE \"rules\" (\n  \"id\" TEXT PRIMARY KEY NOT NULL CHECK (length(\"id\") \u003e 0) CHECK (length(\"id\") \u003c= 24),\n  \"target_id\" TEXT NOT NULL REFERENCES \"targets\" (\"id\"),\n  \"owner_id\" TEXT NOT NULL CHECK (length(\"owner_id\") \u003e 0),\n  \"request_id\" TEXT UNIQUE,\n  \"condition\" TEXT NOT NULL CHECK (\"condition\" IN ('any_sale', 'sale_under_budget')),\n  \"budget_minor\" INTEGER CONSTRAINT \"rule_budget_minor_nonnegative\" CHECK (budget_minor \u003e= 0),\n  \"budget_currency\" TEXT NOT NULL DEFAULT '',\n  \"recurring\" INTEGER NOT NULL DEFAULT 0 CHECK (\"recurring\" IN (0, 1)),\n  \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)),\n  \"latched\" INTEGER NOT NULL DEFAULT 0 CHECK (\"latched\" IN (0, 1)),\n  \"created_at\" TEXT NOT NULL,\n  \"updated_at\" TEXT NOT NULL,\n  CONSTRAINT \"rule_budget\" CHECK ((condition = 'any_sale' AND budget_minor IS NULL AND budget_currency = '') OR (condition = 'sale_under_budget' AND budget_minor IS NOT NULL AND budget_minor \u003e= 0 AND length(budget_currency) = 3 AND budget_currency GLOB '[A-Z][A-Z][A-Z]'))\n) STRICT;",
    "CREATE INDEX \"rules_owner_id_enabled\" ON \"rules\" (\"owner_id\", \"enabled\");",
    "CREATE UNIQUE INDEX \"rules_owner_id_target_id_condition\" ON \"rules\" (\"owner_id\", \"target_id\", \"condition\") WHERE enabled = 1;",
    "CREATE INDEX \"rules_target_id_enabled\" ON \"rules\" (\"target_id\", \"enabled\");",
    "CREATE TABLE \"targets\" (\n  \"id\" TEXT PRIMARY KEY NOT NULL CHECK (length(\"id\") \u003e 0) CHECK (length(\"id\") \u003c= 24),\n  \"app_id\" INTEGER NOT NULL REFERENCES \"apps\" (\"id\"),\n  \"country\" TEXT NOT NULL CHECK (length(\"country\") \u003c= 2),\n  \"next_due_at\" TEXT NOT NULL,\n  \"last_observed_at\" TEXT,\n  \"failure_count\" INTEGER NOT NULL DEFAULT 0 CONSTRAINT \"target_failure_count_nonnegative\" CHECK (failure_count \u003e= 0),\n  \"last_error\" TEXT NOT NULL DEFAULT '',\n  CONSTRAINT \"target_country\" CHECK (length(country) = 2 AND country GLOB '[A-Z][A-Z]')\n) STRICT;",
    "CREATE UNIQUE INDEX \"targets_app_id_country\" ON \"targets\" (\"app_id\", \"country\");",
    "CREATE INDEX \"targets_next_due_at\" ON \"targets\" (\"next_due_at\");"
